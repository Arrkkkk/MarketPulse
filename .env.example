# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Every key is optional; MarketPulse disables the matching feature when one
# is absent rather than failing to start.

# AI news analysis and market insights — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# News for US-listed equities — https://newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=

# News for non-US equities and crypto — https://marketaux.com
MARKETAUX_API_KEY=

# --- optional overrides ---
# GEMINI_MODEL=gemini-1.5-flash
# DEFAULT_REFRESH_SECONDS=60
